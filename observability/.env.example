# Copy this file to observability/.env. Never commit the populated file.
# Generate independent values instead of reusing these placeholders:
#   openssl rand -hex 32
#   openssl rand -base64 32

NEXTAUTH_SECRET=replace-with-random-base64
SALT=replace-with-random-base64
ENCRYPTION_KEY=replace-with-64-hex-characters
POSTGRES_PASSWORD=replace-with-random-hex
CLICKHOUSE_PASSWORD=replace-with-random-hex
REDIS_AUTH=replace-with-random-hex
MINIO_ROOT_PASSWORD=replace-with-random-hex

# Create these project keys in Langfuse after the first login. The standalone
# smoke test uses them to authenticate directly to Langfuse's OTLP endpoint.
LANGFUSE_PUBLIC_KEY=pk-lf-replace-me
LANGFUSE_SECRET_KEY=sk-lf-replace-me
LANGFUSE_BASE_URL=http://localhost:3000

# Optional headless initialization. Leave blank to create these in the UI.
LANGFUSE_INIT_ORG_ID=
LANGFUSE_INIT_ORG_NAME=
LANGFUSE_INIT_PROJECT_ID=
LANGFUSE_INIT_PROJECT_NAME=
LANGFUSE_INIT_PROJECT_PUBLIC_KEY=
LANGFUSE_INIT_PROJECT_SECRET_KEY=
LANGFUSE_INIT_USER_EMAIL=
LANGFUSE_INIT_USER_NAME=
LANGFUSE_INIT_USER_PASSWORD=

TELEMETRY_ENABLED=false
LANGFUSE_ENABLE_EXPERIMENTAL_FEATURES=false
POSTGRES_VERSION=17
